{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sas-wiki/schema/summary.schema.json",
  "title": "wiki_summary",
  "description": "부팅 1회 페이로드 — 사이드바 트리·태그·검색·필터. 본문은 담지 않는다(wiki_body.json). strict: 제거된 필드가 산출물에 있으면 fail 한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "sourceCommit", "docs", "tree", "tags"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "docs": { "type": "array", "items": { "$ref": "#/definitions/summaryDoc" } },
    "tree": { "type": "array", "items": { "$ref": "#/definitions/treeNode" } },
    "tags": {
      "type": "object",
      "description": "태그 → 문서 id[] 역색인(active 만).",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    }
  },
  "definitions": {
    "summaryDoc": {
      "type": "object",
      "description": "status 로 갈리는 유니온 — active 10키 | disable 4키 스텁. discriminator 를 선언하면 검증기가 '어느 분기에도 안 걸림'을 에러로 만든다(그러지 않으면 알 수 없는 status 값이 strict 하위 스키마를 통째로 우회한다).",
      "discriminator": "status",
      "required": ["id", "breadcrumb", "title", "status"],
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
          "then": { "$ref": "#/definitions/activeDoc" }
        },
        {
          "if": { "properties": { "status": { "const": "disable" } }, "required": ["status"] },
          "then": { "$ref": "#/definitions/disableStub" }
        }
      ]
    },
    "activeDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "breadcrumb",
        "title",
        "status",
        "type",
        "tags",
        "aliases",
        "excerpt",
        "created",
        "updated"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
        "breadcrumb": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active"] },
        "type": { "type": "string", "enum": ["concept", "company", "moc"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "excerpt": { "type": "string" },
        "created": { "type": "string" },
        "updated": { "type": "string" }
      }
    },
    "disableStub": {
      "type": "object",
      "description": "본문은 지우되 링크는 살려둔다 — 4키.",
      "additionalProperties": false,
      "required": ["id", "breadcrumb", "title", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
        "breadcrumb": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["disable"] }
      }
    },
    "treeNode": {
      "type": "object",
      "description": "폴더 노드. 재귀 구조라 $ref 없이는 표현할 수 없다.",
      "additionalProperties": false,
      "required": ["path", "docs", "children"],
      "properties": {
        "path": { "type": "string" },
        "docs": { "type": "array", "items": { "type": "string" } },
        "children": { "type": "array", "items": { "$ref": "#/definitions/treeNode" } }
      }
    }
  }
}
