{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sas-wiki/schema/wiki-doc.schema.json",
  "title": "wiki-doc",
  "description": "vault/wiki/<계층경로>/<basename>.md frontmatter 검증 스키마. 계층(path/breadcrumb)은 폴더 위치에서 빌드가 산출한다. id는 frontmatter에 저작된 불변 UUIDv7 내부 키다.",
  "type": "object",
  "required": ["id", "title", "type", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "frontmatter에 저작된 UUIDv7 doc id(시간정렬 · 불변). 이동·재작성해도 바뀌지 않는다. created/updated는 git history에서 유도한다."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "type": {
      "type": "string",
      "enum": ["concept", "company", "moc"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "disable"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "meta": {
      "type": "object",
      "default": {}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "company" } },
        "required": ["type"]
      },
      "then": {
        "required": ["meta"],
        "properties": {
          "meta": {
            "type": "object",
            "required": ["ticker", "sector", "exchange"],
            "properties": {
              "ticker": { "type": ["string", "null"] },
              "sector": { "type": ["string", "null"] },
              "exchange": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
