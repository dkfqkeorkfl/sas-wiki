{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sas-wiki/schema/feeds-artifact.schema.json",
  "title": "cache_feeds",
  "description": "내부 feeds 아티팩트(cache/feeds.<env>.json) — 억제 전 전량을 담는다. wire 가 아니다: raw 로 서빙되지 않는다(억제가 통째로 무효화되는 것을 막는 유일한 가드가 이 비대칭이다). `feedItem`·`docRef` 는 wire feeds.schema.json 과 같은 모양이나, 검증기가 로컬 $ref 만 지원하므로 정의를 이 파일에도 복제한다(교차 파일 참조 불가).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "env", "generatedAt", "sourceCommit", "items"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "env": { "enum": ["dev", "prod"], "type": "string" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "items": { "type": "array", "items": { "$ref": "#/definitions/feedItem" } }
  },
  "definitions": {
    "feedItem": {
      "type": "object",
      "description": "정확히 7키.",
      "additionalProperties": false,
      "required": ["id", "ts", "title", "body", "keywords", "docs", "importance"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
        "ts": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "docs": { "type": "array", "items": { "$ref": "#/definitions/docRef" } },
        "importance": { "type": "string", "enum": ["normal", "highlight", "breaking", "fix"] }
      }
    },
    "docRef": {
      "type": "object",
      "description": "이 커밋이 고친 문서 — path 가 아니라 불변 id 로 가리킨다(문서 이동 내성).",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    }
  }
}
