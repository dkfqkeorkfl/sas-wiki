{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sas-wiki/schema/report.schema.json",
  "title": "summary_report",
  "description": "검증 리포트 — 관측 채널(wire 아님). 예전 `inputs.env` 중첩은 제거됐다 — 같은 값을 두 곳에 두지 않는다. 리포트 출력은 validate.mjs 소유다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "env",
    "generatedAt",
    "sourceCommit",
    "summary",
    "excluded",
    "prunedFeeds",
    "unresolvedPaths",
    "invalidExcludedRefs"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "env": { "type": "string", "enum": ["dev", "prod"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "included", "excluded"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "included": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "id", "reasonCode", "message"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "id": { "type": ["string", "null"] },
          "reasonCode": {
            "type": "string",
            "enum": [
              "NO_FRONTMATTER",
              "MISSING_TYPE",
              "SCHEMA_VIOLATION",
              "DUPLICATE_PATH",
              "DUPLICATE_ID",
              "ID_TAMPERED",
              "DELETED_ID_REUSE"
            ]
          },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prunedFeeds": {
      "type": "integer",
      "minimum": 0,
      "description": "Task 10(F-17) — 생존하지 못하고 드랍된 feed 커밋 수(관측 채널 · 아티팩트 아님)."
    },
    "unresolvedPaths": {
      "type": "array",
      "description": "Task 10(F-17) — fail-closed 로 드랍된 feed 문서 참조({path, sha}).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "invalidExcludedRefs": {
      "type": "array",
      "description": "Task 10(F-17) — 제외된(무효/미공개) 문서를 가리킨 feed 참조({path, sha}).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    }
  }
}
