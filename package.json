{
  "name": "sas-wiki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs --env dev",
    "summary": "node scripts/summary.mjs",
    "feeds": "node scripts/feeds.mjs --count 40",
    "wiki": "node scripts/wiki.mjs --summary cache/summary.prod.json",
    "build": "node scripts/validate.mjs --env prod --report logs && node scripts/summary.mjs --env prod --out cache/summary.prod.json && node scripts/feeds.mjs --env prod --count 200 --ignore ignore-feeds.json --out cache/feeds.prod.json",
    "build-dev": "node scripts/validate.mjs --env dev --report logs && node scripts/summary.mjs --env dev --out cache/summary.dev.json && node scripts/feeds.mjs --env dev --count 200 --ignore ignore-feeds.json --out cache/feeds.dev.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "prettier": "^3.8.3",
    "uuid": "^14.0.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "hast-util-to-string": "^3.0.1",
    "mdast-util-find-and-replace": "^3.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
