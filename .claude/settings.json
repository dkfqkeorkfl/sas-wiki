{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": false,
    "additionalDirectories": ["/tmp"],
    "allow": [
      "Bash(*ls)",
      "Bash(*ls *)",
      "Bash(*cat *)",
      "Bash(*grep *)",
      "Bash(*find *)",
      "Bash(*head *)",
      "Bash(*tail *)",
      "Bash(*wc *)",
      "Bash(*which *)",
      "Bash(*stat *)",
      "Bash(*du *)",
      "Bash(*diff *)",
      "Bash(*tree *)",
      "Bash(*node --version)",
      "Bash(*node -v)",
      "Bash(*python3 --version)",
      "Bash(*python3 -V)",
      "Bash(*npm)",
      "Bash(*npm --version)",
      "Bash(*npm -v)",
      "Bash(*npm ls)",
      "Bash(*npm ls *)",
      "Bash(*npm list)",
      "Bash(*npm list *)",
      "Bash(*npm view *)",
      "Bash(*npm info *)",
      "Bash(*npm show *)",
      "Bash(*npm search *)",
      "Bash(*npm outdated)",
      "Bash(*npm outdated *)",
      "Bash(*npm ping)",
      "Bash(*npm root)",
      "Bash(*npm root *)",
      "Bash(*npm config get *)",
      "Bash(*npm fund)",
      "Bash(*npm fund *)",
      "Bash(*npm doctor)",
      "Bash(*npm explain *)",
      "Bash(*npm bin)",
      "Bash(*npm prefix)",
      "Bash(*npm audit)",
      "Bash(*npm audit --json)",
      "Bash(*npm audit --production)",
      "Bash(*npm test)",
      "Bash(*npm test *)",
      "Bash(*npm run)",
      "Bash(*npm run *)",
      "Bash(*npm start)",
      "Bash(*npm start *)",
      "Bash(*gh search *)",
      "Bash(*gh --version)",
      "Bash(*rtk gain*)",
      "Bash(*rtk discover*)",
      "Bash(*sync)"
    ],
    "deny": [
      "Bash(*npm audit fix*)",
      "Bash(*npm publish*)",
      "Bash(*npm unpublish*)",
      "Bash(*git push --force*)",
      "Bash(*git push -f *)",
      "Bash(*git push -f)",
      "Bash(*git reset --hard*)",
      "Bash(*git clean -f*)",
      "Bash(*git clean -d*)",
      "Bash(*git filter-branch*)",
      "Bash(*git filter-repo*)",
      "Bash(*git gc --prune*)",
      "Bash(*git prune*)",
      "Bash(*git reflog expire*)",
      "Bash(*git reflog delete*)",
      "Bash(*git update-ref -d *)",
      "Bash(*git branch -D *)",
      "Bash(*git branch --delete --force*)",
      "Bash(*git branch -d *)",
      "Bash(*git tag -d *)",
      "Bash(*git push --delete *)",
      "Bash(*git push --mirror*)",
      "Bash(*git push --prune*)",
      "Bash(*git push origin main*)",
      "Bash(*git push origin master*)",
      "Bash(*git push -u origin main*)",
      "Bash(*git push -u origin master*)",
      "Bash(*curl *)",
      "Bash(*wget *)",
      "Bash(*.secret/*)",
      "Bash(*.ssh/*)",
      "Bash(*.aws/*)",
      "Bash(*.kube/*)",
      "Bash(*.config/gh/*)",
      "Bash(*.config/gcloud/*)",
      "Bash(*.npmrc*)",
      "Bash(*.docker/config.json*)",
      "Bash(*github-auth.sh*)",
      "Bash(*grep -r*)",
      "Bash(*grep -R*)",
      "Bash(*grep --recursive*)",
      "Bash(*grep --dereference-recursive*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/scripts/protect-paths-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
